# =============================================================================
# MixLab — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# =============================================================================

# --- Vite / Tauri Dev ---
# Host usado pelo Vite no modo dev (TAURI dev). Deixe vazio para localhost padrão.
TAURI_DEV_HOST=localhost

# --- Banco de Dados (SQLite) ---
# Caminho para o arquivo do banco SQLite. Padrão: ./mixlab.db no diretório de trabalho.
MIXLAB_DB_PATH=./mixlab.db

# --- Segurança / Auth (se aplicável no futuro) ---
# Chave secreta para assinatura de tokens (JWT, sessões, etc.)
MIXLAB_SECRET_KEY=dev-secret-key-change-in-production

# =============================================================================
# Observação: este projeto é um app de desktop Tauri (não uma API web hospedada).
# A maioria das configurações vive em src-tauri/tauri.conf.json.
# =============================================================================
